{
  "manifest_version": 3,
  "name": "AI Chat Layer: folders, prompts, export",
  "short_name": "AI Chat Layer",
  "version": "0.1.0",
  "description": "Folders, prompt library and Markdown export for ChatGPT, Claude and Gemini. Works locally, no account.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "action": { "default_popup": "popup.html", "default_title": "AI Chat Layer" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
      "js": ["src/adapters.js", "src/markdown.js", "src/store.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
