{
  "name": "crypto-checkout",
  "version": "0.1.0",
  "private": true,
  "description": "Non-custodial crypto checkout on Cloudflare Workers: USDC on Base, USDC on Solana, USDT on TON. On-chain watcher, license keys, email delivery.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute checkout --file=./schema.sql",
    "db:init:local": "wrangler d1 execute checkout --local --file=./schema.sql",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
